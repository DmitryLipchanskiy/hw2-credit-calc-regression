{
  "name": "hw2-credit-calc-regression",
  "version": "1.0.0",
  "private": true,
  "description": "Annuity credit calculator regression suite (TypeScript + Playwright)",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "test": "playwright test",
    "test:core": "playwright test tests/core",
    "test:e2e": "playwright test --project=e2e",
    "build:ui": "tsc -p src/ui/tsconfig.ui.json",
    "serve:ui": "node src/ui/serve.mjs",
    "lint": "eslint src tests scripts",
    "check:secrets": "node scripts/check-secrets.mjs --history",
    "lint:forbidden": "node scripts/check-forbidden.mjs --all",
    "build": "tsc -p tsconfig.build.json",
    "oracle:ts": "node scripts/run-cases-ts.mjs",
    "oracle:py": "node scripts/python.mjs oracle/run_cases.py",
    "oracle:compare": "node scripts/python.mjs oracle/compare.py oracle/ts-results.json oracle/expected.json",
    "cross-check": "npm run build && npm run oracle:py && npm run oracle:ts && npm run oracle:compare",
    "ci:evidence": "node scripts/ci-summary.mjs",
    "regression-run": "node scripts/regression-run.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.47.0",
    "eslint": "^10.9.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.67.0"
  },
  "engines": {
    "node": ">=20"
  }
}
